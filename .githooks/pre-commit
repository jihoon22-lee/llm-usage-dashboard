#!/bin/sh
# Fast checks before every commit. Run synthetic browser tests separately (CONTRIBUTING.md).
# Enable once per clone: git config core.hooksPath .githooks
set -e
root=$(git rev-parse --show-toplevel)
python="$root/.venv/bin/python"
# Each checkout must use an independent environment; never fall back to a service venv.
[ -x "$python" ] || { echo "Create this checkout's .venv before committing" >&2; exit 1; }
cd "$root"
for script in llm_usage/web/*.js; do node --check "$script"; done
node --test tests/js/*.test.mjs >/dev/null
"$python" -m unittest discover -s tests -q
